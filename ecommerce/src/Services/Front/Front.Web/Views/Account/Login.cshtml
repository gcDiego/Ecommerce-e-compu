@model LoginViewModel
@{ Layout = null; ViewData["Title"] = "Iniciar sesión"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Iniciar sesión - ECOMPU</title><link rel="stylesheet" href="~/css/site.css" /><link rel="stylesheet" href="~/css/ecompu.css" /></head><body class="auth-body"><main class="auth-card"><a asp-controller="Store" asp-action="Index"><img src="~/images/logo1.png" alt="ECOMPU" /></a><h1>Iniciar sesión</h1><p>Accede a tu cuenta</p><form method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" /><label>Correo electrónico<input type="email" name="email" value="@Model.Email" required autocomplete="email" /></label><label>Contraseña<input type="password" name="password" required autocomplete="current-password" /></label>@if (Model.Error is not null){<div class="alert">@Model.Error</div>}<button class="button primary full" type="submit">Ingresar</button></form><small>El registro y la recuperación se habilitarán al migrar sus APIs.</small></main></body></html>
