
@{
ViewBag.Title = "Carrito";
Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-9">
                            <div class="me-2">

                                <div class="d-flex justify-content-between">
                                    <h5 class="ms-2 mt-2">Detalle Carrito</h5>
                                    <a class="btn btn-primary" href="@Url.Action("Index", "Tienda")"><i
                                                class="fas fa-cart-plus"></i> Seguir Comprando</a>

                                </div>

                                <hr class="mt-2 mb-2"/>

                                <div id="productos-carrito">
                                    <div class="card mb-2 card-producto">
                                        <div class="card-body">
                                            <div class="row">

                                                <div class="col-sm-2 align-self-center d-flex justify-content-center">
                                                    <img class="rounded"
                                                         src="https://dummyimage.com/450x300/dee2e6/6c757d.jpg"
                                                         style="width:100px;height:100px"/>
                                                </div>

                                                <div class="col-sm-4 align-content-center">
                                                    <span class="font-weight-bold d-block">Marca</span>
                                                    <span>Nombre Producto</span>
                                                </div>

                                                <div class="col-sm-2 align-self-center">
                                                    <span>Precio</span>
                                                </div>

                                                <div class="col-sm-2 align-self-center">
                                                    <div class="d-flex">

                                                        <button class="btn btn-outline-secondary btn-restar rounded-0">
                                                            <i class="fas fa-minus"></i>
                                                        </button>
                                                        <input class="form-control input-cantidad p-1 text-center rounded-0"
                                                               disabled style="width:40px"/>

                                                        <button class="btn btn-outline-secondary btn-sumar rounded-0">
                                                            <i class="fas fa-plus"></i>
                                                        </button>


                                                    </div>
                                                </div>

                                                <div class="col-sm-2 align-self-center">
                                                    <button class="btn btn-outline-danger btn-eliminar"><i
                                                                class="far fa-trash-alt"></i>Eliminar
                                                    </button>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <label class="align-content-center"><b>Total: $<span
                                                    id="total"> 0 </span></b></label>
                                </div>

                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="card">
                                <div class="card-body bg-light">
                                    <h5 class="card-title">Detalle Envio</h5>
                                    <form>
                                        <div class="mb-2">
                                            <label for="cbestado" class="form-label">Estado:</label>
                                            <select class="form-select form-select-sm" id="cbestado"></select>
                                        </div>

                                        <div class="mb-2">
                                            <label for="cbmunicipio" class="form-label">Municipio:</label>
                                            <select class="form-select form-select-sm" id="cbmunicipio"></select>
                                        </div>

                                        <div class="mb-2">
                                            <label for="cblocalidad" class="form-label">Localidad:</label>
                                            <select class="form-select form-select-sm" id="cblocalidad"></select>
                                        </div>

                                        <div class="mb-2">
                                            <label for="exampleInputEmail1" class="form-label">Nombre Contacto:</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   id="txtnombrecontacto"/>
                                        </div>

                                        <div class="mb-2">
                                            <label for="exampleInputEmail1" class="form-label">Direccion:</label>
                                            <input type="text" class="form-control form-control-sm" id="txtdireccion"/>
                                        </div>

                                        <div class="mb-2">
                                            <label for="txttelefono" class="form-label">Telefono:</label>
                                            <input type="text" class="form-control form-control-sm" id="txttelefono"/>
                                        </div>

                                        <div class="d-grid">
                                            <button class="btn btn-success" type="button" onclick="RealizarPago()">
                                                <i class="fab fa-paypal"></i> Terminar y Procesar Pago
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{

<script>

    $(document).ready(function () {

        jQuery.ajax({
            url: '@Url.Action("ListarProductosCarrito", "Tienda")',
            type: "POST",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (response) {

                $("#productos-carrito").html("");

                $("#productos-carrito").LoadingOverlay("hide");

                $.each(response.data, function (i, item) {

                    $("<div>").addClass("card mb-2 card-producto").append(
                        $("<div>").addClass("card-body").append(
                            $("<div>").addClass("row").append(
                                $("<div>").addClass("col-sm-2 align-self-center d-flex justify-content-center").append(
                                    $("<img>")
                                        .addClass("rounded")
                                        .attr({
                                            "src": "data:image/" + item.oProducto.Extension.replace(".", "") + ";base64," + item.oProducto.Base64
                                        })
                                        .css({
                                            "width": "100px",
                                            "height": "100px"
                                        })
                                ),

                                $("<div>").addClass("col-sm-4 align-content-center").append(
                                    $("<span>").addClass("font-weight-bold d-block").text(item.oProducto.oMarca.Descripcion),
                                    $("<span>").text(item.oProducto.Nombre)
                                ),

                                $("<div>").addClass("col-sm-2 align-self-center").append(
                                    $("<span>").text(item.oProducto.Precio.toFixed(2) + " MXN")
                                ),

                                $("<div>").addClass("col-sm-2 align-self-center").append(
                                    $("<div>").addClass("d-flex").append(
                                        $("<button>").addClass("btn btn-outline-secondary btn-restar rounded-0").append(
                                            $("<i>").addClass("fas fa-minus")
                                        ),

                                        $("<input>").addClass("form-control input-cantidad p-1 text-center rounded-0")
                                            .attr({"disabled": "disabled"})
                                            .css("width", "40px")
                                            .data("oProducto", item.oProducto)
                                            .val(item.Cantidad),

                                        $("<button>").addClass("btn btn-outline-secondary btn-sumar rounded-0").append(
                                            $("<i>").addClass("fas fa-plus")
                                        )
                                    )
                                ),

                                $("<div>").addClass("col-sm-2 align-self-center").append(
                                    $("<button>").addClass("btn btn-outline-danger btn-eliminar").append(
                                        $("<i>").addClass("far fa-trash-alt")
                                    ).append(" Eliminar").data("idproducto", item.oProducto.IdProducto)
                                )
                            )
                        )
                    ).appendTo("#productos-carrito");


                })
                sumarTotal();
            },
            error: function (error) {
                $("#productos-carrito").LoadingOverlay("hide");
            },
            beforeSend: function () {
                $("#productos-carrito").LoadingOverlay("show");
            }
        })

        ListarEstado()
    })

    function ListarEstado() {

        $("<option>").attr({
            "value": "0",
            "disabled": "disabled",
            "selected": "true"
        }).text("Seleccionar").appendTo("#cbestado")

        jQuery.ajax({
            url: '@Url.Action("ObtenerEstado", "Tienda")',
            type: "POST",
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.lista != null) {
                    $.each(data.lista, function (i, item) {
                        $("<option>").attr({"value": item.IdEstado}).text(item.Descripcion).appendTo("#cbestado")

                    })

                    ListarMunicipio()
                }

            }

        })
    }

    $("#cbestado").on("change", function () {
        ListarMunicipio()
    })

    function ListarMunicipio() {

        $("#cbmunicipio").html("")

        var estadoSeleccionado = $("#cbestado option:selected").val();

        $("<option>").attr({
            "value": "0",
            "disabled": "disabled",
            "selected": "true"
        }).text("Seleccionar").appendTo("#cbmunicipio")

        jQuery.ajax({
            url: '@Url.Action("ObtenerMunicipio", "Tienda")',
            type: "POST",
            data: JSON.stringify({IdEstado: estadoSeleccionado}),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.lista != null) {
                    $.each(data.lista, function (i, item) {
                        $("<option>").attr({"value": item.IdMunicipio}).text(item.Descripcion).appendTo("#cbmunicipio")
                    })

                    ListarLocalidad()
                }

            }
        })
    }

    $("#cbmunicipio").on("change", function () {
        ListarLocalidad()
    })

    function ListarLocalidad() {

        $("#cblocalidad").html("")

        var estadoSeleccionado = $("#cbestado option:selected").val();
        var municipioSeleccionado = $("#cbmunicipio option:selected").val();

        $("<option>").attr({
            "value": "0",
            "disabled": "disabled",
            "selected": "true"
        }).text("Seleccionar").appendTo("#cblocalidad")

        jQuery.ajax({
            url: '@Url.Action("ObtenerLocalidad", "Tienda")',
            type: "POST",
            data: JSON.stringify({IdEstado: estadoSeleccionado, IdMunicipio: municipioSeleccionado}),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                if (data.lista != null) {
                    $.each(data.lista, function (i, item) {
                        $("<option>").attr({"value": item.IdLocalidad}).text(item.Descripcion).appendTo("#cblocalidad")
                    })
                }

            }
        })
    }

    function sumarTotal() {
        var sumaTotal = 0;

        $("input.input-cantidad").each(function () {
            var precio = $(this).data("oProducto").Precio;
            var cantidad = parseFloat($(this).val()) || 0;

            sumaTotal += precio * cantidad;
        });

        $("#total").text(sumaTotal.toFixed(2))
        $("#total").data("sumaTotal", sumaTotal)
    }

    $(document).on("click", ".btn-sumar", function () {
        var div_contenedor = $(this).parent("div.d-flex")

        var input_cantidad = $(div_contenedor).find("input.input-cantidad")

        var btn = $(this)

        var idproducto = $(input_cantidad).data("oProducto").IdProducto;

        jQuery.ajax({
            url: '@Url.Action("OperacionCarrito", "Tienda")',
            type: "POST",
            data: JSON.stringify({idproducto: idproducto, sumar: true}),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $(btn).LoadingOverlay("hide")
                if (data.respuesta) {
                    var cantidad = parseInt($(input_cantidad).val()) + 1
                    $(input_cantidad).val(cantidad)

                    sumarTotal()
                } else {
                    swal("", data.mensaje, "warning")
                }
            },
            beforeSend: function () {
                $(btn).LoadingOverlay("show")
            },
            error: function () {
                $(btn).LoadingOverlay("show")
            }
        })
    })

    $(document).on("click", ".btn-restar", function () {
        var div_contenedor = $(this).parent("div.d-flex")

        var input_cantidad = $(div_contenedor).find("input.input-cantidad")

        var btn = $(this)

        var idproducto = $(input_cantidad).data("oProducto").IdProducto;

        var cantidad = parseInt($(input_cantidad).val()) - 1

        if (cantidad >= 1) {
            jQuery.ajax({
                url: '@Url.Action("OperacionCarrito", "Tienda")',
                type: "POST",
                data: JSON.stringify({idproducto: idproducto, sumar: false}),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $(btn).LoadingOverlay("hide")
                    if (data.respuesta) {

                        $(input_cantidad).val(cantidad)

                        sumarTotal()
                    } else {
                        swal("", data.mensaje, "warning")
                    }
                },
                beforeSend: function () {
                    $(btn).LoadingOverlay("show")
                },
                error: function () {
                    $(btn).LoadingOverlay("show")
                }
            })
        }


    })

    $(document).on("click", ".btn-eliminar", function () {

        var idproducto = $(this).data("idproducto");

        var card_producto = $(this).parents("div.card-producto")


        jQuery.ajax({
            url: '@Url.Action("EliminarCarrito", "Tienda")',
            type: "POST",
            data: JSON.stringify({idproducto: idproducto}),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                if (data.respuesta) {

                    card_producto.remove();

                    MostrarCantidadCarrito();

                    sumarTotal();

                    sumarTotal()
                } else {
                    swal("", data.mensaje, "warning")
                }
            },
            error: function () {
                swal("Error", "No se pudo eliminar el producto. Intenta más tarde.", "error");
            }

        })


    })

    function RealizarPago() {

        if (parseInt($("#cantidadcarrito").text()) == 0) {
            swal("", "No exite productos en el carrito", "warning");
            return
        }

        if ($("#cblocalidad").val() == null || $("#txtnombrecontacto").val() == "" || $("#txtdireccion").val() == "" || $("#txttelefono").val() == "") {
            swal("", "Deve completar todos los campos de Detalle de Envio", "warning");
            return
        }


        var venta = {
            TotalProducto: $("input.input-cantidad").length,
            MontoTotal: 0,
            Contacto: $("#txtnombrecontacto").val(),
            IdLocalidad: $("#cblocalidad").val(),
            Telefono: $("#txttelefono").val(),
            Direccion: $("#txtdireccion").val()
        }

        var lista_carrito = [];


        $("input.input-cantidad").each(function (i) {
            var producto = $(this).data("oProducto");
            var cantidad = parseFloat($(this).val())

            lista_carrito.push({
                oProducto: producto,
                Cantidad: cantidad
            })
        })
        jQuery.ajax({
            url: '@Url.Action("ProcesarPago", "Tienda")',
            type: "POST",
            data: JSON.stringify({oListarCarrito: lista_carrito, oVenta: venta}),
            dataType: "json",
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                $.LoadingOverlay("hide")
                if (data.Status) {
                    var jsonresult = data.Response;

                    var links = jsonresult.links;

                    var resultado = links.find(item => item.rel === "approve");

                    window.location.href = resultado.href;
                } else {
                    swal("", "vuelve a intentarlo mas tarde", "warning");
                }
            },
            beforeSend: function () {
                $.LoadingOverlay("show")
            },
            error: function () {
                $.LoadingOverlay("hide")
            }
        })


    }


</script>


}
